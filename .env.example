KGEO_HOST=127.0.0.1
KGEO_PORT=18308
KGEO_INTERNAL_TOKEN=replace-with-a-long-random-token
KGEO_DEV_USER=local
KGEO_ADMIN_USERS=xb_bittensor
KGEO_DB=/home/kojima/work/kgeo/data/kgeo.db

# 管理者は0.3のローカルGemma 4、一般ユーザーはDeepSeekへ振り分けます。
KGEO_OLLAMA_BASE_URL=http://127.0.0.1:11434
KGEO_OLLAMA_MODEL=gemma4:12b-it-qat
KGEO_OLLAMA_TIMEOUT=180
KGEO_DEEPSEEK_BASE_URL=https://api.deepseek.com
KGEO_DEEPSEEK_API_KEY=
# 既存の秘密ファイルを使う場合。値そのものをリポジトリへ保存しません。
KGEO_DEEPSEEK_API_KEY_FILE=
KGEO_DEEPSEEK_API_KEY_NAME=DEEPSEEK_API_KEY
KGEO_DEEPSEEK_MODEL=deepseek-v4-flash
KGEO_DEEPSEEK_TIMEOUT=180

# 診断課金は公開PHPゲートウェイで管理（初回無料、以後200円または20,000 URLAI）。
# この値は旧バージョンとの設定互換用で、監査回数の制限には使いません。
KGEO_FREE_AUDITS_PER_MONTH=3
KGEO_FREE_MONITOR_RUNS_PER_MONTH=5
KGEO_MAX_SITES_PER_USER=20
